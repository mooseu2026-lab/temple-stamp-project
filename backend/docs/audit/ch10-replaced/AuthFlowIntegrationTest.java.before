package com.templestamp.auth;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.templestamp.global.config.AppProperties;
import io.jsonwebtoken.Jwts;
import io.jsonwebtoken.io.Decoders;
import io.jsonwebtoken.security.Keys;
import jakarta.servlet.http.Cookie;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.MvcResult;

import javax.crypto.SecretKey;
import java.time.LocalDateTime;
import java.util.Date;
import java.util.List;
import java.util.Map;

import static org.assertj.core.api.Assertions.assertThat;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

/**
 * 인증 흐름 종단 실측. 실제 MySQL(temple_stamp_project)에 붙어 컨트롤러부터 DB 까지 그대로 지난다.
 * <p>
 * 단위 테스트로 나누지 않은 이유가 있다. 여기서 확인하려는 것들 —
 * 계정 잠금이 실제로 커밋되는지, 필터 구간 401 이 ApiResponse 모양으로 나가는지,
 * 쿠키 속성이 무엇으로 실려 나가는지 — 은 전부 계층 사이에서만 드러난다.
 * 서비스만 모킹해 부르면 트랜잭션 경계가 사라져 잠금 버그가 그대로 통과한다.
 * <p>
 * 테스트가 만든 계정은 이메일 접두어로 골라 매번 지운다. refresh_token 은 FK 가
 * ON DELETE CASCADE 라 함께 사라진다.
 */
@SpringBootTest
@AutoConfigureMockMvc
class AuthFlowIntegrationTest {

    /** 이 접두어로 시작하는 계정만 테스트가 만들고 지운다. 개발 중 만든 계정과 섞이지 않게. */
    private static final String EMAIL_PREFIX = "auth-it-";
    private static final String PASSWORD = "test1234!";
    private static final String WRONG_PASSWORD = "wrong1234!";

    @Autowired MockMvc mvc;
    @Autowired ObjectMapper om;
    @Autowired JdbcTemplate jdbc;
    @Autowired AppProperties appProperties;

    @BeforeEach
    void cleanUp() {
        removeTestAccounts();
    }

    /** 개발 DB 에 테스트 계정을 남기지 않는다. 실패로 중단돼도 다음 실행의 @BeforeEach 가 다시 지운다. */
    @AfterEach
    void cleanUpAfter() {
        removeTestAccounts();
    }

    private void removeTestAccounts() {
        jdbc.update("DELETE FROM users WHERE email LIKE ?", EMAIL_PREFIX + "%");
    }

    /* ---------------- 가입 · 로그인 · 보호 API ---------------- */

    @Test
    @DisplayName("가입 → 로그인 → 유효한 토큰으로 보호 API 조회까지 통한다")
    void signup_login_then_access_protected_api() throws Exception {
        String email = email("happy");

        // 가입: 201, 응답에 password 가 없어야 한다
        mvc.perform(post("/api/auth/signup")
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(signupJson(email)))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.success").value(true))
                .andExpect(jsonPath("$.data.email").value(email))
                .andExpect(jsonPath("$.data.password").doesNotExist());

        // BCrypt 로 저장됐는지는 DB 를 직접 본다. 응답으로는 확인할 수 없는 항목이다.
        String stored = jdbc.queryForObject(
                "SELECT password FROM users WHERE email = ?", String.class, email);
        assertThat(stored).startsWith("$2a$");
        assertThat(stored).isNotEqualTo(PASSWORD);

        MvcResult login = login(email, PASSWORD).andExpect(status().isOk())
                .andExpect(jsonPath("$.data.tokenType").value("Bearer"))
                .andExpect(jsonPath("$.data.expiresIn").value(1800))
                .andReturn();

        String accessToken = read(login).path("data").path("accessToken").asText();
        assertThat(accessToken).isNotBlank();

        // 리프레시 쿠키 속성 — 규약 §5
        Cookie cookie = login.getResponse().getCookie("refreshToken");
        assertThat(cookie).isNotNull();
        assertThat(cookie.isHttpOnly()).isTrue();
        assertThat(cookie.getPath()).isEqualTo("/api/auth");
        assertThat(cookie.getMaxAge()).isEqualTo(7 * 24 * 60 * 60);
        assertThat(cookie.getSecure()).isEqualTo(appProperties.cookie().secure());
        assertThat(login.getResponse().getHeader(HttpHeaders.SET_COOKIE)).contains("SameSite=Strict");

        // 원문이 아니라 SHA-256 해시(64자 hex)만 저장돼 있어야 한다
        String hash = jdbc.queryForObject("""
                SELECT rt.token_hash FROM refresh_token rt
                JOIN users u ON u.user_id = rt.user_id WHERE u.email = ?
                """, String.class, email);
        assertThat(hash).hasSize(64).matches("[0-9a-f]{64}");
        assertThat(hash).isNotEqualTo(cookie.getValue());

        // 본문에는 리프레시가 실리지 않는다
        assertThat(login.getResponse().getContentAsString()).doesNotContain(cookie.getValue());

        // 보호 API — 이 프로젝트의 보호 API 1호
        mvc.perform(get("/api/users/me").header(HttpHeaders.AUTHORIZATION, "Bearer " + accessToken))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.success").value(true))
                .andExpect(jsonPath("$.data.email").value(email))
                .andExpect(jsonPath("$.data.password").doesNotExist());
    }

    @Test
    @DisplayName("중복 이메일 가입은 409 AUTH-4090")
    void duplicate_email_is_rejected() throws Exception {
        String email = email("dup");
        mvc.perform(post("/api/auth/signup").contentType(MediaType.APPLICATION_JSON)
                .content(signupJson(email))).andExpect(status().isCreated());

        mvc.perform(post("/api/auth/signup").contentType(MediaType.APPLICATION_JSON)
                        .content(signupJson(email)))
                .andExpect(status().isConflict())
                .andExpect(jsonPath("$.success").value(false))
                .andExpect(jsonPath("$.error.code").value("AUTH-4090"));
    }

    /* ---------------- 필터 구간 401 ---------------- */

    @Test
    @DisplayName("토큰 없이 보호 API 는 401 AUTH-4013")
    void no_token_returns_4013() throws Exception {
        mvc.perform(get("/api/users/me"))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.success").value(false))
                .andExpect(jsonPath("$.error.code").value("AUTH-4013"));
    }

    @Test
    @DisplayName("서명이 어긋난 토큰도 401 AUTH-4013 — 이유를 구분해 알려주지 않는다")
    void tampered_token_returns_4013() throws Exception {
        mvc.perform(get("/api/users/me")
                        .header(HttpHeaders.AUTHORIZATION, "Bearer eyJhbGciOiJIUzI1NiJ9.e30.bogus"))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4013"));
    }

    @Test
    @DisplayName("만료된 액세스 토큰은 401 AUTH-4013 — 30분을 기다리지 않고 과거 exp 로 확인한다")
    void expired_access_token_returns_4013() throws Exception {
        String email = email("expired");
        signup(email);
        long userId = userId(email);

        mvc.perform(get("/api/users/me")
                        .header(HttpHeaders.AUTHORIZATION, "Bearer " + expiredAccessToken(userId, email)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4013"));
    }

    /* ---------------- 계정 잠금 ---------------- */

    @Test
    @DisplayName("1~4회는 401, 5회째에 403 AUTH-4031 로 잠긴다")
    void five_failures_lock_the_account() throws Exception {
        String email = email("lock");
        signup(email);

        // 1~4회 — 아직 잠기지 않았으므로 자격 불일치로만 응답한다
        for (int attempt = 1; attempt <= 4; attempt++) {
            login(email, WRONG_PASSWORD)
                    .andExpect(status().isUnauthorized())
                    .andExpect(jsonPath("$.error.code").value("AUTH-4011"));

            // 여기가 핵심이다. 실패 카운트는 예외를 던진 뒤에도 커밋돼 있어야 한다.
            // noRollbackFor 가 빠지면 이 값이 매번 0 이라 잠금이 영원히 걸리지 않는다.
            assertThat(failCount(email)).as("%d번째 실패 후 카운트", attempt).isEqualTo(attempt);
        }

        // 5회째 — 이 요청이 카운트를 5로 올리며 잠근다. 잠긴 사실을 그 자리에서 알려야 한다.
        login(email, WRONG_PASSWORD)
                .andExpect(status().isForbidden())
                .andExpect(jsonPath("$.error.code").value("AUTH-4031"))
                .andExpect(jsonPath("$.error.message").value(org.hamcrest.Matchers.containsString("분")));
        assertThat(failCount(email)).isEqualTo(5);

        assertThat(lockedUntil(email))
                .as("5회째에 잠금 시각이 찍혀야 한다")
                .isNotNull()
                .isAfter(LocalDateTime.now())
                .isBefore(LocalDateTime.now().plusMinutes(16));

        // 잠긴 뒤에는 올바른 비밀번호도 통과하지 못한다 — 비밀번호 검사보다 잠금 확인이 먼저다
        login(email, PASSWORD)
                .andExpect(status().isForbidden())
                .andExpect(jsonPath("$.error.code").value("AUTH-4031"));
    }

    @Test
    @DisplayName("4회 실패 뒤 성공하면 카운트가 0으로 돌아간다")
    void success_resets_the_counter() throws Exception {
        String email = email("reset");
        signup(email);

        for (int i = 0; i < 4; i++) {
            login(email, WRONG_PASSWORD).andExpect(status().isUnauthorized());
        }
        assertThat(failCount(email)).isEqualTo(4);

        login(email, PASSWORD).andExpect(status().isOk());

        assertThat(failCount(email)).isZero();
        assertThat(lockedUntil(email)).isNull();
    }

    /* ---------------- 회전 · 재사용 탐지 ---------------- */

    @Test
    @DisplayName("재발급은 액세스·리프레시를 둘 다 새로 준다(회전)")
    void refresh_rotates_both_tokens() throws Exception {
        String email = email("rotate");
        signup(email);

        MvcResult first = login(email, PASSWORD).andExpect(status().isOk()).andReturn();
        String cookie1 = first.getResponse().getCookie("refreshToken").getValue();
        String access1 = read(first).path("data").path("accessToken").asText();

        MvcResult second = mvc.perform(post("/api/auth/refresh").cookie(new Cookie("refreshToken", cookie1)))
                .andExpect(status().isOk())
                .andReturn();
        String cookie2 = second.getResponse().getCookie("refreshToken").getValue();
        String access2 = read(second).path("data").path("accessToken").asText();

        assertThat(cookie2).isNotEqualTo(cookie1);
        assertThat(access2).isNotBlank();
        // 액세스 토큰은 iat 가 초 단위라 같은 초에 발급되면 문자열이 같을 수 있다. 그래서 동등성은
        // 단언하지 않고, 새 토큰이 실제로 통하는지만 본다.
        mvc.perform(get("/api/users/me").header(HttpHeaders.AUTHORIZATION, "Bearer " + access2))
                .andExpect(status().isOk());
        assertThat(access1).isNotBlank();

        // 쓰인 토큰은 폐기 표시가 남고, 새 토큰은 살아 있다
        List<Map<String, Object>> rows = jdbc.queryForList("""
                SELECT rt.revoked_at FROM refresh_token rt
                JOIN users u ON u.user_id = rt.user_id
                WHERE u.email = ? ORDER BY rt.refresh_token_id
                """, email);
        assertThat(rows).hasSize(2);
        assertThat(rows.get(0).get("revoked_at")).isNotNull();
        assertThat(rows.get(1).get("revoked_at")).isNull();
    }

    @Test
    @DisplayName("회전된 옛 토큰을 다시 쓰면 401 AUTH-4015 이고 그 사용자의 세션이 전부 끊긴다")
    void reuse_of_rotated_token_revokes_every_session() throws Exception {
        String email = email("reuse");
        signup(email);

        String cookieA = login(email, PASSWORD).andExpect(status().isOk())
                .andReturn().getResponse().getCookie("refreshToken").getValue();

        String cookieB = mvc.perform(post("/api/auth/refresh").cookie(new Cookie("refreshToken", cookieA)))
                .andExpect(status().isOk())
                .andReturn().getResponse().getCookie("refreshToken").getValue();

        // 진짜 사용자가 옛 토큰으로 다시 들어온 상황 = 어딘가에서 A 가 이미 쓰였다는 뜻
        mvc.perform(post("/api/auth/refresh").cookie(new Cookie("refreshToken", cookieA)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4015"));

        // 401 만 나가고 끝나면 안 된다. 도둑이 쥔 B 까지 실제로 죽어 있어야 한다.
        // revokeAllByUser 가 롤백되면 아래 두 단언이 무너진다.
        Integer alive = jdbc.queryForObject("""
                SELECT COUNT(*) FROM refresh_token rt
                JOIN users u ON u.user_id = rt.user_id
                WHERE u.email = ? AND rt.revoked_at IS NULL
                """, Integer.class, email);
        assertThat(alive).isZero();

        mvc.perform(post("/api/auth/refresh").cookie(new Cookie("refreshToken", cookieB)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4015"));
    }

    @Test
    @DisplayName("쿠키 없이 재발급하면 401 AUTH-4014")
    void refresh_without_cookie_returns_4014() throws Exception {
        mvc.perform(post("/api/auth/refresh"))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4014"));
    }

    @Test
    @DisplayName("만료된 리프레시 토큰은 401 AUTH-4012")
    void expired_refresh_token_returns_4012() throws Exception {
        String email = email("refresh-expired");
        signup(email);
        String cookie = login(email, PASSWORD).andExpect(status().isOk())
                .andReturn().getResponse().getCookie("refreshToken").getValue();

        // 7일을 기다릴 수 없으니 만료 시각을 과거로 돌려놓는다
        jdbc.update("""
                UPDATE refresh_token rt JOIN users u ON u.user_id = rt.user_id
                SET rt.expires_at = NOW() - INTERVAL 1 DAY WHERE u.email = ?
                """, email);

        mvc.perform(post("/api/auth/refresh").cookie(new Cookie("refreshToken", cookie)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4012"));
    }

    /* ---------------- 로그아웃 ---------------- */

    @Test
    @DisplayName("로그아웃하면 쿠키가 Max-Age=0 으로 지워지고 리프레시가 폐기된다")
    void logout_clears_cookie_and_revokes_token() throws Exception {
        String email = email("logout");
        signup(email);

        MvcResult login = login(email, PASSWORD).andExpect(status().isOk()).andReturn();
        String cookie = login.getResponse().getCookie("refreshToken").getValue();
        String access = read(login).path("data").path("accessToken").asText();

        MvcResult out = mvc.perform(post("/api/auth/logout")
                        .header(HttpHeaders.AUTHORIZATION, "Bearer " + access)
                        .cookie(new Cookie("refreshToken", cookie)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.success").value(true))
                .andReturn();

        Cookie cleared = out.getResponse().getCookie("refreshToken");
        assertThat(cleared).isNotNull();
        assertThat(cleared.getMaxAge()).isZero();
        assertThat(cleared.getValue()).isEmpty();
        assertThat(cleared.getPath()).isEqualTo("/api/auth");

        // 지워진 쿠키를 되살려 써도 통하지 않아야 한다
        mvc.perform(post("/api/auth/refresh").cookie(new Cookie("refreshToken", cookie)))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4015"));
    }

    @Test
    @DisplayName("액세스 토큰이 만료돼 비로그인으로 들어와도 로그아웃은 200 이다")
    void logout_without_login_is_idempotent() throws Exception {
        mvc.perform(post("/api/auth/logout"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.success").value(true));
    }

    /* ---------------- 공통 예외 매핑 ---------------- */

    @Test
    @DisplayName("공개 경로의 없는 URL 은 404 COMMON-4040, 잘못된 메서드는 405 COMMON-4050")
    void unknown_path_and_method_are_mapped() throws Exception {
        // 공개 경로(permitAll)라야 요청이 DispatcherServlet 까지 도달해 404 가 된다
        mvc.perform(get("/api/auth/no-such-endpoint"))
                .andExpect(status().isNotFound())
                .andExpect(jsonPath("$.error.code").value("COMMON-4040"));

        mvc.perform(get("/api/auth/login"))
                .andExpect(status().isMethodNotAllowed())
                .andExpect(jsonPath("$.error.code").value("COMMON-4050"));
    }

    @Test
    @DisplayName("보호 경로의 없는 URL 은 404 가 아니라 401 이다 — 경로 존재 여부를 알려주지 않는다")
    void unknown_path_under_protected_area_stays_401() throws Exception {
        // 의도된 동작이다. 시큐리티가 DispatcherServlet 앞에서 끊으므로 404 에 도달하지 않고,
        // 덕분에 "이 URL 은 있고 저 URL 은 없다" 를 비로그인 상태에서 훑을 수 없다.
        mvc.perform(get("/api/no-such-endpoint"))
                .andExpect(status().isUnauthorized())
                .andExpect(jsonPath("$.error.code").value("AUTH-4013"));
    }

    @Test
    @DisplayName("깨진 JSON 본문은 400 COMMON-4004")
    void broken_body_is_mapped() throws Exception {
        mvc.perform(post("/api/auth/login").contentType(MediaType.APPLICATION_JSON).content("{"))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.error.code").value("COMMON-4004"));
    }

    @Test
    @DisplayName("검증 실패는 400 COMMON-4000 이고 fields 에 필드별 사유가 담긴다")
    void validation_failure_carries_fields() throws Exception {
        mvc.perform(post("/api/auth/signup").contentType(MediaType.APPLICATION_JSON)
                        .content("""
                                {"email":"not-an-email","password":"short","nickname":"x"}
                                """))
                .andExpect(status().isBadRequest())
                .andExpect(jsonPath("$.error.code").value("COMMON-4000"))
                .andExpect(jsonPath("$.error.fields").isArray())
                .andExpect(jsonPath("$.error.fields.length()").value(org.hamcrest.Matchers.greaterThanOrEqualTo(3)));
    }

    /* ---------------- 도우미 ---------------- */

    private String email(String tag) {
        return EMAIL_PREFIX + tag + "@templestamp.test";
    }

    private String signupJson(String email) {
        return """
                {"email":"%s","password":"%s","nickname":"통합테스트"}
                """.formatted(email, PASSWORD);
    }

    private void signup(String email) throws Exception {
        mvc.perform(post("/api/auth/signup").contentType(MediaType.APPLICATION_JSON)
                .content(signupJson(email))).andExpect(status().isCreated());
    }

    private org.springframework.test.web.servlet.ResultActions login(String email, String password)
            throws Exception {
        return mvc.perform(post("/api/auth/login").contentType(MediaType.APPLICATION_JSON)
                .content("""
                        {"email":"%s","password":"%s"}
                        """.formatted(email, password)));
    }

    private JsonNode read(MvcResult result) throws Exception {
        return om.readTree(result.getResponse().getContentAsString());
    }

    private long userId(String email) {
        return jdbc.queryForObject("SELECT user_id FROM users WHERE email = ?", Long.class, email);
    }

    private int failCount(String email) {
        return jdbc.queryForObject(
                "SELECT login_fail_count FROM users WHERE email = ?", Integer.class, email);
    }

    private LocalDateTime lockedUntil(String email) {
        return jdbc.queryForObject(
                "SELECT locked_until FROM users WHERE email = ?", LocalDateTime.class, email);
    }

    /** 운영과 같은 키로 서명하되 exp 만 과거인 토큰. 서명은 유효하고 만료만 지난 상태를 만든다. */
    private String expiredAccessToken(long userId, String email) {
        SecretKey key = Keys.hmacShaKeyFor(Decoders.BASE64.decode(appProperties.jwt().secret()));
        Date past = new Date(System.currentTimeMillis() - 60_000);
        return Jwts.builder()
                .subject(String.valueOf(userId))
                .claim("email", email)
                .claim("role", "USER")
                .issuedAt(new Date(past.getTime() - 1_000))
                .expiration(past)
                .signWith(key)
                .compact();
    }
}
