<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.templestamp.stamp.StampMapper">

    <sql id="columns">
        stamp_id, pilgrimage_id, course_site_id, verify_status, verify_method,
        accuracy_grade, gps_verified_at, qr_verified_at, mission_verified_at,
        mission_id, expansion_phrase_id, site_id,
        user_sentence, photo_key, evidence_photo_key, pending_reason,
        reviewed_by, reviewed_at, review_note, completed_course_site_id,
        created_at, updated_at
    </sql>

    <insert id="save" parameterType="com.templestamp.stamp.Stamp"
            useGeneratedKeys="true" keyProperty="stampId">
        INSERT INTO stamp (pilgrimage_id, course_site_id, site_id, verify_status, verify_method,
                           accuracy_grade, gps_verified_at)
        VALUES (#{pilgrimageId}, #{courseSiteId}, #{siteId}, #{verifyStatus}, #{verifyMethod},
                #{accuracyGrade}, #{gpsVerifiedAt})
        <!-- v4: site_id = 실제로 서 있는 후보 사찰. QR 검증·이동시간·생각상자가 전부 이 값을 기준으로 돈다 -->
    </insert>

    <select id="findById" resultType="com.templestamp.stamp.Stamp">
        SELECT <include refid="columns"/> FROM stamp WHERE stamp_id = #{stampId}
    </select>

    <!-- 완료 행이 있으면 그것을 우선한다. 그 자리는 이미 끝났다는 사실이 가장 중요하기 때문이다. -->
    <select id="findLatest" resultType="com.templestamp.stamp.Stamp">
        SELECT <include refid="columns"/>
        FROM stamp
        WHERE pilgrimage_id = #{pilgrimageId}
          AND course_site_id = #{courseSiteId}
        ORDER BY (verify_status = 'COMPLETED') DESC,
                 (verify_status = 'PENDING') DESC,
                 stamp_id DESC
        LIMIT 1
    </select>

    <select id="countCompleted" resultType="int">
        SELECT COUNT(*) FROM stamp
        WHERE pilgrimage_id = #{pilgrimageId} AND verify_status = 'COMPLETED'
    </select>

    <!-- ================= 상태 전이 ================= -->

    <!--
      만료·반려로 닫혔던 행도 GPS 를 다시 통과하면 여기서 되살아난다.
      다시 시작하는 것이므로 QR·미션 흔적을 지우고 시계를 새로 건다.
    -->
    <!--
      ★ SET 절은 왼쪽부터 평가된다(정리.md §6-1). 아래 대입은 전부 상수·파라미터이고
        다른 컬럼을 읽는 것이 하나도 없으므로 순서에 자유롭다.
      created_at 을 지금으로 되돌리는 이유: 하루 한도가 created_at 기준인데, 어제 만료된 행을
        오늘 재사용하면 그 도장이 오늘 한도에 잡히지 않는다. 다시 시작하는 것이므로 시각도 다시 건다.
    -->
    <update id="markGpsDone">
        UPDATE stamp
        SET verify_status     = 'GPS_DONE',
            verify_method     = 'GPS_QR',
            site_id           = #{siteId},
            created_at        = NOW(),
            accuracy_grade    = #{accuracyGrade},
            gps_verified_at   = NOW(),
            qr_verified_at    = NULL,
            mission_id        = NULL,
            mission_verified_at = NULL,
            expansion_phrase_id = NULL,
            pending_reason    = NULL,
            review_note       = NULL
        WHERE stamp_id = #{stampId}
          AND verify_status IN ('GPS_DONE','QR_DONE','EXPIRED','REJECTED')
    </update>

    <!-- 60분 창을 SQL 에서 한 번 더 확인한다. 애플리케이션 검사와 실제 갱신 사이의 틈을 없앤다. -->
    <update id="markQrDone">
        UPDATE stamp
        SET verify_status  = 'QR_DONE',
            mission_id     = #{missionId},
            qr_verified_at = NOW()
        WHERE stamp_id = #{stampId}
          AND verify_status = 'GPS_DONE'
          AND gps_verified_at >= DATE_SUB(NOW(), INTERVAL #{sessionMinutes} MINUTE)
    </update>

    <update id="markCompleted">
        UPDATE stamp
        <!-- ★ MySQL 은 SET 절을 왼쪽부터 평가한다. 여기 대입은 서로를 읽지 않으므로 순서에 자유롭다.
             다른 컬럼을 읽는 대입을 나중에 넣을 때는 읽는 쪽을 먼저 두어야 한다(정리.md §6-1). -->
        SET verify_status       = 'COMPLETED',
            user_sentence       = #{userSentence},
            photo_key           = #{photoKey},
            expansion_phrase_id = #{expansionPhraseId},
            mission_verified_at = NOW()
        WHERE stamp_id = #{stampId}
          AND verify_status = 'QR_DONE'
          AND gps_verified_at >= DATE_SUB(NOW(), INTERVAL #{sessionMinutes} MINUTE)
    </update>

    <update id="markPending">
        UPDATE stamp
        SET verify_status      = 'PENDING',
            verify_method      = #{verifyMethod},
            evidence_photo_key = COALESCE(#{evidencePhotoKey}, evidence_photo_key),
            pending_reason     = #{pendingReason},
            site_id            = COALESCE(#{siteId}, site_id),
            expansion_phrase_id = COALESCE(#{expansionPhraseId}, expansion_phrase_id),
            user_sentence      = COALESCE(#{userSentence}, user_sentence)
        WHERE stamp_id = #{stampId}
          AND verify_status IN ('GPS_DONE','QR_DONE','EXPIRED','REJECTED')
    </update>

    <!-- 승인이면 완료 시각을 지금으로 박는다. 반려면 완료 시각을 비운다. -->
<!--
      심사 대상은 셋이다 — 대기(PENDING)·완료(COMPLETED, 회수)·반려(REJECTED, 재승인).
      진행 중이거나 만료된 행은 여기서 막힌다. 어느 방향이 허용되는지는 Service 가 먼저 본다.
      mission_verified_at 을 COMPLETED 일 때만 채우므로 회수하면 다시 비워진다.
    -->
    <update id="markReviewed">
        UPDATE stamp
        SET verify_status       = #{status},
            reviewed_by         = #{reviewedBy},
            reviewed_at         = NOW(),
            review_note         = #{reviewNote},
            mission_verified_at = CASE WHEN #{status} = 'COMPLETED' THEN NOW() ELSE NULL END
        WHERE stamp_id = #{stampId}
          AND verify_status IN ('PENDING', 'COMPLETED', 'REJECTED')
    </update>

    <select id="findPhotoKeysByUser" resultType="string">
        SELECT s.photo_key
        FROM stamp s
                 JOIN pilgrimage p ON p.pilgrimage_id = s.pilgrimage_id
        WHERE p.user_id = #{userId}
          AND s.photo_key IS NOT NULL
          AND s.photo_key &lt;&gt; ''
    </select>

    <!--
      탈퇴 — 행은 남기고 개인 내용만 비운다.
      사진 키를 지우기 전에 storage_orphan 에 적어 둔다(호출부 순서). 여기서 파일을 지우지 않는 이유는
      저장소가 아프면 탈퇴 전체가 롤백되기 때문이다.
    -->
    <update id="scrubPersonalByUser">
        UPDATE stamp s
            JOIN pilgrimage p ON p.pilgrimage_id = s.pilgrimage_id
        SET s.photo_key = NULL,
            s.user_sentence = NULL
        WHERE p.user_id = #{userId}
          AND (s.photo_key IS NOT NULL OR s.user_sentence IS NOT NULL)
    </update>

<!--
      탈퇴 — 그 사람의 열린 세션만 닫는다(GPS_DONE·QR_DONE·PENDING).
      COMPLETED 는 그대로 둔다. 완주·인증서가 그 위에 서 있고, 지우면 통계까지 흔들린다.
    -->
    <update id="expireOpenByUser">
        UPDATE stamp
        SET verify_status = 'EXPIRED'
        WHERE verify_status IN ('GPS_DONE', 'QR_DONE', 'PENDING')
          AND pilgrimage_id IN (SELECT pilgrimage_id FROM pilgrimage WHERE user_id = #{userId})
    </update>

    <update id="expireStale">
        UPDATE stamp
        SET verify_status = 'EXPIRED'
        WHERE verify_status IN ('GPS_DONE','QR_DONE')
          AND gps_verified_at IS NOT NULL
          AND gps_verified_at &lt; DATE_SUB(NOW(), INTERVAL #{sessionMinutes} MINUTE)
    </update>

    <!--
      한 건만 즉시 EXPIRED 로 닫는다. StampExpireService 가 REQUIRES_NEW 로 부르므로
      곧 뒤따르는 409 예외가 호출자의 트랜잭션을 롤백해도 이 갱신은 살아남는다(정리.md §6-2).
      이미 COMPLETED·PENDING·REJECTED 인 행은 WHERE 가 막는다.
    -->
    <update id="markExpiredIfStale">
        UPDATE stamp SET verify_status = 'EXPIRED'
        WHERE stamp_id = #{stampId}
          AND verify_status IN ('GPS_DONE','QR_DONE')
          AND gps_verified_at &lt; DATE_SUB(NOW(), INTERVAL #{sessionMinutes} MINUTE)
        <!-- 만료 판정을 WHERE 에 두면 "자바에서 읽고 → 쓰는" 사이에 끼어들 틈이 없다([기본 45] 와 같은 이유).
             0행이면 아직 만료가 아니라는 뜻이고, Service 는 그걸 그대로 "만료 아님" 으로 읽는다. -->
    </update>

    <!--
      증빙 접수 — GPS·QR 을 거치지 않으므로 처음부터 PENDING 으로 넣는다.
      EXPIRED 를 시작 상태로 썼다가 markPending 으로 넘기던 방식은, 실패하면 "만료된 적 없는데 만료" 인
      행이 남고 무엇보다 읽는 사람을 속인다.
    -->
    <insert id="insertEvidence" parameterType="com.templestamp.stamp.Stamp"
            useGeneratedKeys="true" keyProperty="stampId">
        INSERT INTO stamp (pilgrimage_id, course_site_id, site_id, verify_status, verify_method,
                           pending_reason, user_sentence, evidence_photo_key)
        VALUES (#{pilgrimageId}, #{courseSiteId}, #{siteId}, 'PENDING', 'EVIDENCE',
                'EVIDENCE', #{userSentence}, #{evidencePhotoKey})
    </insert>

    <!-- 잠금 읽기. 2·3단계는 이것으로 시작한다(잠금 순서 pilgrimage → stamp) -->
    <select id="findByIdForUpdate" resultType="com.templestamp.stamp.Stamp">
        SELECT <include refid="columns"/> FROM stamp WHERE stamp_id = #{stampId} FOR UPDATE
    </select>

    <!-- 하루 한도 2종. 자정 기준(CURDATE)이라 시간대는 서버 시간을 따른다 -->
    <!--
      하루 한도는 "오늘 만든 도장 중 살아 있는 것" 으로 센다.
      COMPLETED 만 세면 이동시간 미달로 PENDING 에 빠진 건이 한도에서 빠져나가고,
      그것이 나중에 승인되면 그날 완료가 한도를 넘는다.
      EXPIRED·REJECTED 만 빼는 이유는 그 둘은 사용자가 다시 시도해야 하는, 실패한 시도이기 때문이다.
    -->
    <select id="countActiveToday" resultType="int">
        SELECT COUNT(*) FROM stamp st JOIN pilgrimage p ON p.pilgrimage_id = st.pilgrimage_id
        WHERE p.user_id = #{userId}
          AND st.created_at >= CURDATE()
          AND st.verify_status NOT IN ('EXPIRED', 'REJECTED')
    </select>

    <select id="countEvidenceToday" resultType="int">
        SELECT COUNT(*) FROM stamp st JOIN pilgrimage p ON p.pilgrimage_id = st.pilgrimage_id
        WHERE p.user_id = #{userId}
          AND st.verify_method = 'EVIDENCE'
          AND st.created_at >= CURDATE()
    </select>

    <!-- Q1 ① : 이 자리에서 내가 이미 받은 완료 도장. 409 메시지와 by-slot 조회가 함께 쓴다 -->
    <select id="findCompletedBySlot" resultType="com.templestamp.stamp.Stamp">
        <!-- JOIN 하지 않고 IN 으로 좁힌다. 공용 columns 조각이 접두어 없는 이름이라
             JOIN 하면 pilgrimage_id 가 ambiguous 로 터진다. -->
        SELECT <include refid="columns"/>
        FROM stamp
        WHERE completed_course_site_id = #{courseSiteId}
          AND pilgrimage_id IN (SELECT pilgrimage_id FROM pilgrimage WHERE user_id = #{userId})
        LIMIT 1
    </select>

    <!-- ================= 이동시간 검증 ================= -->

    <select id="findLastCompletedSiteId" resultType="long">
        SELECT cs.site_id
        FROM stamp st
                 JOIN course_site cs ON cs.course_site_id = st.course_site_id
        WHERE st.pilgrimage_id = #{pilgrimageId}
          AND st.verify_status = 'COMPLETED'
          AND st.mission_verified_at IS NOT NULL
        ORDER BY st.mission_verified_at DESC
        LIMIT 1
    </select>

    <select id="findMinutesSinceLastCompleted" resultType="int">
        SELECT TIMESTAMPDIFF(MINUTE, MAX(mission_verified_at), NOW())
        FROM stamp
        WHERE pilgrimage_id = #{pilgrimageId}
          AND verify_status = 'COMPLETED'
          AND mission_verified_at IS NOT NULL
    </select>

    <!-- ================= 관리자 ================= -->

    <select id="findPending" resultType="com.templestamp.admin.dto.PendingStampRow">
        SELECT st.stamp_id,
               p.user_id,
               u.nickname,
               st.pilgrimage_id,
               c.course_id,
               c.name              AS course_name,
               cs.position,
               s.site_id,
               s.name              AS site_name,
               st.verify_method,
               st.accuracy_grade,
               st.evidence_photo_key AS photo_key,
               st.pending_reason,
               st.user_sentence,
               st.created_at
        FROM stamp st
                 JOIN pilgrimage p ON p.pilgrimage_id = st.pilgrimage_id
                 JOIN users u ON u.user_id = p.user_id
                 JOIN course_site cs ON cs.course_site_id = st.course_site_id
                 JOIN course c ON c.course_id = cs.course_id
                 JOIN site s ON s.site_id = cs.site_id
        WHERE st.verify_status = 'PENDING'
        ORDER BY st.created_at
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPending" resultType="long">
        SELECT COUNT(*) FROM stamp WHERE verify_status = 'PENDING'
    </select>

    <!-- ================= 보상 심사 근거 ================= -->

    <select id="countByUserAndMethod" resultType="int">
        SELECT COUNT(*)
        FROM stamp st
                 JOIN pilgrimage p ON p.pilgrimage_id = st.pilgrimage_id
        WHERE p.user_id = #{userId}
          AND st.verify_status = 'COMPLETED'
          AND st.verify_method = #{verifyMethod}
    </select>

    <select id="countCompletedByUser" resultType="int">
        SELECT COUNT(*)
        FROM stamp st
                 JOIN pilgrimage p ON p.pilgrimage_id = st.pilgrimage_id
        WHERE p.user_id = #{userId}
          AND st.verify_status = 'COMPLETED'
    </select>

    <!--
      완료 시각을 순서대로 늘어놓고 이웃한 두 건의 간격 중 가장 짧은 값을 구한다.
      도장이 한 건뿐이면 비교할 상대가 없어 NULL 이 나오고, 그때는 판단 근거로 쓰지 않는다.
    -->
    <select id="findMinCompletionGapSeconds" resultType="long">
        SELECT MIN(gap)
        FROM (SELECT TIMESTAMPDIFF(SECOND,
                                   LAG(mission_verified_at) OVER (ORDER BY mission_verified_at),
                                   mission_verified_at) AS gap
              FROM stamp
              WHERE pilgrimage_id = #{pilgrimageId}
                AND verify_status = 'COMPLETED'
                AND mission_verified_at IS NOT NULL) t
        WHERE gap IS NOT NULL
    </select>

    <select id="countTravelTimeFlags" resultType="int">
        SELECT COUNT(*)
        FROM stamp st
                 JOIN pilgrimage p ON p.pilgrimage_id = st.pilgrimage_id
        WHERE p.user_id = #{userId}
          AND st.pending_reason = 'TRAVEL_TIME'
    </select>

</mapper>
