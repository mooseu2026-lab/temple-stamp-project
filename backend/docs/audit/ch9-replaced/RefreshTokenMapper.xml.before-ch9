<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.templestamp.auth.RefreshTokenMapper">

    <insert id="save" parameterType="com.templestamp.auth.RefreshToken"
            useGeneratedKeys="true" keyProperty="refreshTokenId">
        INSERT INTO refresh_token (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt})
    </insert>

    <select id="findByTokenHash" resultType="com.templestamp.auth.RefreshToken">
        SELECT refresh_token_id, user_id, token_hash, expires_at, revoked_at, created_at
        FROM refresh_token
        WHERE token_hash = #{tokenHash}
    </select>

    <update id="revoke">
        UPDATE refresh_token
        SET revoked_at = NOW()
        WHERE token_hash = #{tokenHash}
          AND revoked_at IS NULL
    </update>

    <update id="revokeAllByUser">
        UPDATE refresh_token
        SET revoked_at = NOW()
        WHERE user_id = #{userId}
          AND revoked_at IS NULL
    </update>

    <!-- 폐기된 토큰도 만료 시각이 지나기 전까지는 남겨 둔다. 재사용 감지 근거가 되기 때문이다. -->
    <delete id="deleteExpired">
        DELETE FROM refresh_token
        WHERE expires_at &lt; NOW()
    </delete>

</mapper>
