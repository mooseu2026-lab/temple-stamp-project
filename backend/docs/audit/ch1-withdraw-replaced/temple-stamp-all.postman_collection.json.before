       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const s = pm.response.json().data.sites;",
         "pm.test('자리 5칸', () => pm.expect(s).to.have.lengthOf(5));",
         "pm.test('자리마다 candidates 가 실린다 (v4)', () => pm.expect(s[0].candidates).to.be.an('array'));",
         "for (let i = 0; i < 5; i++) {",
         "  pm.environment.set('cs' + (i + 1), s[i].courseSiteId);",
         "  pm.environment.set('st' + (i + 1), s[i].siteId);",
         "}",
         "// V 폴더가 쓸 DRAFT 사찰 하나 — 시드 110곳은 전부 DRAFT 다."
