    {
     "name": "W04 코스 인증서 1장 — 번호 형식·VALID",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const it = pm.response.json().data.items;",
         "console.log('[W04] ' + it.map(x => x.certType + ':' + x.serialNo + ':' + x.status).join(', '));",
         "pm.test('1장', () => pm.expect(it).to.have.lengthOf(1));",
         "pm.test('코스 인증서', () => pm.expect(it[0].certType).to.eql('PILGRIMAGE'));",
         "pm.test('번호 PG-yyyy-6자리', () => pm.expect(it[0].serialNo).to.match(/^PG-\\d{4}-\\d{6}$/));",
         "pm.test('VALID', () => pm.expect(it[0].status).to.eql('VALID'));",
         "pm.environment.set('wCertSerial', it[0].serialNo);"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{wToken}}"
       }
      ],
