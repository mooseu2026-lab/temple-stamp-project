     "name": "M18 코스 상세 ?target=RIDER — 후보 정렬이 SUNROAD 먼저",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const sites = pm.response.json().data.sites;",
         "pm.test('자리 5칸', () => pm.expect(sites).to.have.lengthOf(5));",
         "const withSunroad = sites.filter(s => (s.candidates||[]).some(x => x.track === 'SUNROAD'));",
         "console.log('[M18] SUNROAD 후보가 있는 자리 ' + withSunroad.length + '개');",
         "withSunroad.forEach(s => pm.test('자리 ' + s.position + ' 는 SUNROAD 가 먼저',",
         "  () => pm.expect(s.candidates[0].track).to.eql('SUNROAD')));",
         "sites.forEach(s => pm.test('자리 ' + s.position + ' 에 후보가 있다', () => pm.expect(s.candidates.length).to.be.above(0)));"
        ]
       }
      }
