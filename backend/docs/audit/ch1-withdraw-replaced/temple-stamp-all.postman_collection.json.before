    {
     "name": "R08 내 보상 (T10 뒤라 1건 이상)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const it = pm.response.json().data.items;",
         "console.log('[R08] 보상 ' + it.length + '건 ' + it.map(r => r.rewardType + ':' + r.status + ':' + r.claimable).join(', '));",
         "pm.test('1건 이상', () => pm.expect(it.length).to.be.above(0));",
         "// claimable 은 서버가 계산한다 — PHYSICAL 이고 GRANTED/REJECTED 이고 내 것일 때만 true.",
         "// 이 시드에서 도장 완료로 받는 것은 STAMP 형이라 claimable 이 없다. 그 사실 자체를 여기서 확인한다.",
         "it.forEach(r => pm.test('claimable 은 PHYSICAL 에만 (' + r.rewardType + ')', () =>",
         "  pm.expect(r.claimable).to.eql(r.rewardType === 'PHYSICAL' && ['GRANTED', 'REJECTED'].includes(r.status))));",
         "const target = it.find(r => r.claimable) || it[0];",
         "pm.environment.set('userRewardId', target.userRewardId);",
         "pm.environment.set('userRewardType', target.rewardType);"
        ]
       }
      }
     ],
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/api/rewards",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "rewards"
       ]
      }
     }
    },
    {
     "name": "R09 수령 신청 — 실물이 아니면 400 (챕터 7 §4-3)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const physical = pm.environment.get('userRewardType') === 'PHYSICAL';",
         "console.log('[R09 claim] ' + pm.response.code + ' ' + pm.response.text().slice(0, 200));",
         "if (physical) {",
         "  pm.test('실물이면 200 접수', () => pm.response.to.have.status(200));",
         "  pm.test('접수되면 CLAIMED · claimable false', () => {",
         "    const d = pm.response.json().data;",
         "    pm.expect(d.status).to.eql('CLAIMED');",
         "    pm.expect(d.claimable).to.eql(false);",
         "  });",
         "} else {",
         "  pm.test('실물이 아니면 400', () => pm.response.to.have.status(400));",
         "  pm.test('REWARD-4001 수령 신청 대상 아님', () => pm.expect(pm.response.json().error.code).to.eql('REWARD-4001'));",
         "}",
         "pm.test('5xx 아님', () => pm.expect(pm.response.code).to.be.below(500));"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
