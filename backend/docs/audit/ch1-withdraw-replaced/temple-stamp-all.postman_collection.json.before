    {
     "name": "R28 [5-1 확인] 같은 보상 재신청 — 같은 이유로 다시 막힌다",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "// 5-1 은 고쳤다. 첫 신청(R09)이 이미 막히므로 두 번째도 같은 코드로 막히는 것이 맞다.",
         "// 실물 보상이 있으면 그때는 이미 접수된 상태라 409 REWARD-4092 다.",
         "// 실물 보상을 실제로 접수했다가 다시 누르는 409 경로는 W11·W12 가 본다(이 폴더에는 실물 보상이 없다).",
         "const physical = pm.environment.get('userRewardType') === 'PHYSICAL';",
         "if (physical) {",
         "  pm.test('재신청은 409', () => pm.response.to.have.status(409));",
         "  pm.test('REWARD-4092 이미 신청됨', () => pm.expect(pm.response.json().error.code).to.eql('REWARD-4092'));",
         "} else {",
         "  pm.test('실물이 아니면 몇 번을 눌러도 400', () => pm.response.to.have.status(400));",
         "  pm.test('REWARD-4001', () => pm.expect(pm.response.json().error.code).to.eql('REWARD-4001'));",
         "}",
         "console.log('[R28] ' + pm.response.code + ' ' + (pm.response.json().error || {}).code);"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
