    {
     "name": "W05 공개 진위 확인 (토큰 없이)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const d = pm.response.json().data;",
         "pm.test('VALID', () => pm.expect(d.status).to.eql('VALID'));",
         "pm.test('닉네임이 마스킹돼 있다', () => pm.expect(d.holderMasked).to.match(/^.\\*/));",
         "// 비로그인으로 나가는 유일한 개인 데이터다. 신원을 되짚을 수 있는 것은 하나도 실리면 안 된다.",
         "['userId', 'email', 'phone', 'address', 'nickname', 'holderNickname'].forEach(k =>",
         "  pm.test('응답에 ' + k + ' 없음', () => pm.expect(d).to.not.have.property(k)));"
        ]
       }
      }
     ],
