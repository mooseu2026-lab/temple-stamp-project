         "pm.test('slots 5', () => pm.expect(cs[0].slots.length).to.eql(5));",
         "pm.test('totalCourses = ACTIVE 코스 수', () => pm.expect(d.summary.totalCourses).to.eql(d.regions.flatMap(r => r.courses).length));"
        ]
