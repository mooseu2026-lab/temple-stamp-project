         "console.log('[W08] ' + it.map(r => r.rewardType + ':' + r.status + ':' + r.claimable).join(', '));",
         "pm.test('1건 이상', () => pm.expect(it.length).to.be.above(0));",
         "it.forEach(r => pm.test('claimable = 실물 AND 신청 가능 상태 (' + r.rewardType + ')', () =>",
         "  pm.expect(r.claimable).to.eql(r.rewardType === 'PHYSICAL' && ['GRANTED', 'REJECTED'].includes(r.status))));",
         "const digital = it.find(r => r.rewardType !== 'PHYSICAL');",
         "pm.environment.set('wDigitalReward', digital ? digital.userRewardId : 0);"
        ]
