-- backend/docs/verify/alter-ch1-withdraw.sql — 챕터 1 보강(회원 탈퇴) 스키마 변경
--
--   mysql -uroot -p temple_stamp_project < backend/docs/verify/alter-ch1-withdraw.sql
--
-- schema.sql 은 CREATE TABLE IF NOT EXISTS 라 이미 있는 표에 컬럼을 더하지 않는다.
-- 그래서 이미 만들어진 DB(로컬·운영)에는 이 파일을 손으로 한 번 돌려야 한다. 운영 목록은 정리.md §5-1.
USE temple_stamp_project;

-- ⑨ 탈퇴는 행을 지우지 않는다 — 상태와 시각만 남긴다.
--    물리 DELETE 를 하면 FK 연쇄로 인증서·완주 기록까지 사라지고, 그러면 이미 발급된
--    인증서 번호를 제3자가 확인할 수 없게 된다.
ALTER TABLE users
    ADD COLUMN status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE' AFTER role,
    ADD COLUMN deleted_at DATETIME NULL AFTER updated_at;
ALTER TABLE users
    ADD CONSTRAINT chk_users_status CHECK (status IN ('ACTIVE', 'DELETED'));

-- ⑩ 비밀번호 해시는 탈퇴할 때 비운다. NOT NULL 이면 비울 수가 없다.
--    빈 문자열로 두지 않는 이유는, 빈 값도 "해시가 있다" 로 읽히기 때문이다.
ALTER TABLE users
    MODIFY COLUMN password VARCHAR(255) NULL;

-- ⑪ 저장소에 남은 파일을 지울 큐. 탈퇴가 적재하고 챕터 9 청소기가 소비한다.
--    파일 삭제를 트랜잭션 안에서 하지 않는 이유 — 저장소 호출이 실패하면 탈퇴 전체가 롤백된다.
--    지워야 할 키를 먼저 적어 두고, 실제 삭제는 나중에 따로 한다.
CREATE TABLE IF NOT EXISTS storage_orphan (
    storage_orphan_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    file_key VARCHAR(500) NOT NULL,                 -- 저장소 키
    reason VARCHAR(30) NOT NULL,                    -- USER_WITHDRAWN / PHOTO_REPLACED(챕터 9)
    enqueued_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    deleted_at DATETIME NULL,                       -- 청소기가 실제로 지운 시각. NULL 이면 아직 남아 있다
    INDEX idx_storage_orphan_pending (deleted_at, enqueued_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- 확인
SELECT '⑨ users.status·deleted_at' AS step;
SHOW COLUMNS FROM users LIKE 'status';
SHOW COLUMNS FROM users LIKE 'deleted_at';
SELECT '⑩ users.password NULL 허용' AS step;
SHOW COLUMNS FROM users LIKE 'password';
SELECT '⑪ storage_orphan' AS step;
SHOW TABLES LIKE 'storage_orphan';
