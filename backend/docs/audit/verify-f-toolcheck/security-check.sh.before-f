#!/usr/bin/env bash
# backend/docs/verify/security-check.sh — 보안 점검 (전체 점검 C §4)
#
#   bash backend/docs/verify/security-check.sh [bootRun 로그 파일]
#
# 여기서 보는 것은 요청으로 확인할 수 없는 것들이다 — 설정·저장된 값·로그.
#   S5 토큰   S6 시크릿   S7 비밀번호   S11 CORS   S12 개인정보
# S1·S2·S3·S8·S9·S10 은 컬렉션 X 폴더가 요청으로 확인한다.
cd "$(dirname "$0")/../../.."
LOG=${1:-app.log}
OUT=backend/docs/verify/security-check-result.txt
BASE=${BASE_URL:-http://localhost:8080}
DB=temple_stamp_project
DB_USER=${DB_USER:-root}
DB_PASS=${DB_PASS:-1234}
MYSQL=${MYSQL_BIN:-mysql}
PASS=0; FAIL=0

q() { "$MYSQL" -u"$DB_USER" -p"$DB_PASS" --default-character-set=utf8mb4 -N -e "USE $DB; $1" 2>/dev/null | tr -d '\r'; }
say() { echo "$@" | tee -a "$OUT"; }
ok()  { say "  ✅ $1"; PASS=$((PASS+1)); }
ng()  { say "  ❌ $1"; FAIL=$((FAIL+1)); }
chk() { if [ "$1" = "$2" ]; then ok "$3 ($1)"; else ng "$3 — 기대 '$2' 실제 '$1'"; fi; }

: > "$OUT"
say "=================================================================="
say " 보안 점검 — $(date '+%Y-%m-%d %H:%M:%S')"
say "=================================================================="

say ""
say "── S5  토큰 ────────────────────────────────────────────────────"
say "기대: 액세스 30분 · refresh 는 해시로만 저장 · 쿠키 HttpOnly·SameSite · prod 는 Secure."
# 위쪽 주석 줄에도 "access-seconds" 라는 말이 있다. 들여쓴 설정 줄만 골라야 값이 잡힌다.
ACCESS_SEC=$(grep -E '^[[:space:]]+access-seconds:' src/main/resources/application.yml | head -1 | sed 's/#.*//' | tr -dc '0-9')
chk "${ACCESS_SEC:-없음}" "1800" "액세스 토큰 수명(초 · 30분)"
HASHED=$(q "SELECT COUNT(*) FROM refresh_token WHERE token_hash LIKE '%.%' OR CHAR_LENGTH(token_hash) <> 64;")
chk "${HASHED:-?}" "0" "refresh 는 전부 SHA-256 해시(64자)로만 저장"
COOKIE=$(curl -s -i -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json' \
  --data-binary @backend/docs/verify/body/admin-login.json | grep -i '^set-cookie' | head -1)
say "  Set-Cookie: $COOKIE"
echo "$COOKIE" | grep -qi 'HttpOnly' && ok "HttpOnly" || ng "HttpOnly 없음"
echo "$COOKIE" | grep -qi 'SameSite' && ok "SameSite" || ng "SameSite 없음"
if grep -qE 'secure:\s*true' src/main/resources/application-prod.yml 2>/dev/null; then ok "prod 는 Secure=true"; else ng "prod 에 cookie.secure=true 가 없다"; fi

say ""
say "── S6  시크릿 ──────────────────────────────────────────────────"
say "기대: JWT≠QR · .env.local 미커밋 · 로그에 토큰·비밀번호·시크릿 미출력."
JWT=$(grep -E '^JWT_SECRET=' .env.local 2>/dev/null | cut -d= -f2-)
QR=$(grep -E '^QR_SECRET=' .env.local 2>/dev/null | cut -d= -f2-)
if [ -n "$JWT" ] && [ "$JWT" != "$QR" ]; then ok "JWT 와 QR 시크릿이 다르다"; else ng "JWT·QR 시크릿이 같거나 비어 있다"; fi
if grep -qx '.env.local' .gitignore 2>/dev/null; then ok ".gitignore 에 .env.local"; else ng ".env.local 이 .gitignore 에 없다"; fi
LEAK=$(grep -nEi 'JWT_SECRET|QR_SECRET|DB_PASSWORD|KAKAO_REST_API_KEY|password=[^&]|Bearer ey' "$LOG" 2>/dev/null | head -5)
if [ -z "$LEAK" ]; then ok "로그에 시크릿·토큰·비밀번호 없음"; else ng "로그에 새는 값이 있다"; echo "$LEAK" | sed 's/^/      /' | tee -a "$OUT"; fi
SRC_LEAK=$(grep -rnE 'log\.(info|warn|error|debug)\([^)]*(getPassword|accessToken|refreshToken|secret)' src/main/java 2>/dev/null | head -5)
if [ -z "$SRC_LEAK" ]; then ok "로그 문장에 토큰·비밀번호를 넣는 코드 없음"; else ng "로그 문장이 민감값을 찍는다"; echo "$SRC_LEAK" | sed 's/^/      /' | tee -a "$OUT"; fi

say ""
say "── S7  비밀번호 ────────────────────────────────────────────────"
say "기대: BCrypt(\$2a\$/\$2b\$) 로만 저장. 평문·MD5·SHA 흔적 0."
# 탈퇴 계정은 해시가 <b>NULL 이어야 한다</b>(챕터 1 보강 — 비밀번호를 비운다).
# 전체와 비교하면 탈퇴가 한 건이라도 남아 있는 순간 이 검사가 거짓으로 실패한다 — 실제로 그렇게 걸렸다.
# 그래서 살아 있는 계정만 해시를 요구하고, 탈퇴 계정은 반대로 "비어 있는가" 를 따로 본다.
TOTAL=$(q "SELECT COUNT(*) FROM users WHERE status = 'ACTIVE';")
BC=$(q "SELECT COUNT(*) FROM users WHERE status = 'ACTIVE' AND (password LIKE '\$2a\$%' OR password LIKE '\$2b\$%' OR password LIKE '\$2y\$%');")
chk "$BC" "$TOTAL" "살아 있는 계정이 전부 BCrypt 해시 ($TOTAL 계정)"
LEFTOVER=$(q "SELECT COUNT(*) FROM users WHERE status = 'DELETED' AND password IS NOT NULL;")
chk "${LEFTOVER:-?}" "0" "탈퇴 계정에 남은 비밀번호 해시"
LEN=$(q "SELECT MIN(CHAR_LENGTH(password)) FROM users;")
if [ "${LEN:-0}" -ge 59 ]; then ok "해시 길이 최소 $LEN (BCrypt 60)"; else ng "해시가 짧다 — $LEN"; fi

say ""
say "── S11  CORS ───────────────────────────────────────────────────"
say "기대: allow-credentials 가 true 면 오리진에 * 를 쓸 수 없다. 허용 밖 오리진은 거부."
if grep -qE 'allowed-origins:\s*\*' src/main/resources/application*.yml 2>/dev/null; then
  ng "오리진에 * 가 있다 (credentials 와 함께 쓸 수 없다)"; else ok "오리진에 * 없음"; fi
ALLOWED=$(grep -A2 '^cors:' src/main/resources/application.yml | grep 'allowed-origins' | cut -d: -f2- | tr -d ' ')
say "  허용 오리진: $ALLOWED"
PRE=$(curl -s -o /dev/null -w '%{http_code}' -X OPTIONS "$BASE/api/regions" \
  -H 'Origin: http://evil.example.com' -H 'Access-Control-Request-Method: GET')
ALLOW_HDR=$(curl -s -i -X OPTIONS "$BASE/api/regions" -H 'Origin: http://evil.example.com' \
  -H 'Access-Control-Request-Method: GET' | grep -ci 'access-control-allow-origin' || true)
say "  허용 밖 오리진 preflight → HTTP $PRE · Allow-Origin 헤더 $ALLOW_HDR 개"
if [ "$ALLOW_HDR" = "0" ]; then ok "허용 밖 오리진에 Allow-Origin 을 주지 않는다"; else ng "허용 밖 오리진에 Allow-Origin 을 준다"; fi

say ""
say "── S12  개인정보 ───────────────────────────────────────────────"
say "기대: 위치동의 없이 GPS 403 · 공개 인증서 닉네임 마스킹 · 비공개/타인얼굴은 전자책에서 제외."
if grep -q 'requireLocationAgreement' src/main/java/com/templestamp/stamp/StampService.java; then
  ok "GPS 인증이 위치기반서비스 동의를 먼저 본다"; else ng "위치 동의 검사가 없다"; fi
if grep -q 'maskNickname' src/main/java/com/templestamp/certificate/dto/CertificateVerifyResponse.java; then
  ok "공개 인증서 응답이 닉네임을 마스킹한다"; else ng "닉네임 마스킹이 없다"; fi
PUBQ=$(grep -c 'is_private = 0' src/main/resources/mapper/thinkbox/ThinkboxMapper.xml || true)
if [ "${PUBQ:-0}" -ge 1 ]; then ok "전자책 수록 질의가 is_private = 0 만 고른다"; else ng "전자책 질의에 is_private 필터가 없다"; fi
say "  전자책 제외 대상 실측:"
q "SELECT CONCAT('    thinkbox 비공개 ', SUM(is_private), ' / 전체 ', COUNT(*)) FROM thinkbox;"
q "SELECT CONCAT('    photo 비공개 ', SUM(is_private), ' · 타인얼굴 ', SUM(has_other_face), ' / 전체 ', COUNT(*)) FROM photo;"

say ""
say "── S13  비로그인 허용 목록 실측 (전체 점검 D) ───────────────────"
say "기대: SecurityConfig 에서 뽑은 목록만 열리고 나머지 76개는 전부 필터가 막는다."
say "     문서로만 맞춰 두면 매처 한 줄이 어긋난 날 아무도 모른다 — 그래서 전부 두드린다."
PROBE=$(node backend/docs/verify/open-endpoint-probe.js 2>&1)
say "$PROBE"
if echo "$PROBE" | grep -q "어긋남 0"; then ok "허용 목록과 실측이 일치"; else ng "허용 목록과 실측이 어긋난다"; fi

say ""
say "── S14  관리자·편집자 전용 경로 (재집계 2·회수 1 · 원고 9 · 청소기·사용자 2) ──"
say "기대: 토큰 없으면 401, USER 토큰이면 403. 관리자 경로는 새로 생길 때마다 여기서 확인한다."
# 점검용 사용자 하나를 만들고(있으면 409 — 무시) 그 토큰으로 두드린다.
curl -s -o /dev/null -X POST "$BASE/api/auth/signup" -H 'Content-Type: application/json' \
  --data-binary @backend/docs/verify/body/sec-user.json
SEC_TOKEN=$(curl -s -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json' \
  --data-binary @backend/docs/verify/body/sec-login.json | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).data.accessToken)}catch(e){console.log('')}})")
for PATHX in "/api/admin/completions/recount/1" "/api/admin/completions/recount" "/api/admin/certificates/1/revoke"; do
  NO_TOKEN=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json' -d '{}')
  AS_USER=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json' \
    -H "Authorization: Bearer $SEC_TOKEN" -d '{}')
  chk "$NO_TOKEN" "401" "토큰 없이 $PATHX"
  chk "$AS_USER" "403" "USER 토큰으로 $PATHX"
done

# 챕터 8 — 원고 문 두 벌. 편집자 문은 EDITOR·ADMIN, 심사 문은 ADMIN 만이다.
say ""
say "  · 챕터 9 관리자 문 — 청소기 · 사용자 목록"
for PATHX in "/api/admin/housekeeping/run" "/api/admin/users"; do
  NO_TOKEN=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json' -d '{}')
  AS_USER=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json' \
    -H "Authorization: Bearer $SEC_TOKEN" -d '{}')
  chk "$NO_TOKEN" "401" "토큰 없이 $PATHX"
  chk "$AS_USER" "403" "USER 토큰으로 $PATHX"
done

say ""
say "  · 챕터 8 원고 문 — 편집자 4 · 심사 5"
for PATHX in "/api/editor/manuscripts" "/api/editor/manuscripts/1/submit"              "/api/admin/manuscripts/1/approve" "/api/admin/manuscripts/1/reject"              "/api/admin/manuscripts/1/retire" "/api/admin/manuscripts/import"; do
  NO_TOKEN=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json' -d '{}')
  AS_USER=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json'     -H "Authorization: Bearer $SEC_TOKEN" -d '{}')
  chk "$NO_TOKEN" "401" "토큰 없이 $PATHX"
  chk "$AS_USER" "403" "USER 토큰으로 $PATHX"
done

# 편집자는 자기 문만 연다. 쓰는 사람과 내보내는 사람을 가르는 것이 4-eyes 의 절반이다.
ED_TOKEN=$(curl -s -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json'   --data-binary @backend/docs/verify/body/editor-login.json | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).data.accessToken)}catch(e){console.log('')}})")
ED_OWN=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/api/editor/manuscripts" -H "Authorization: Bearer $ED_TOKEN")
ED_REVIEW=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE/api/admin/manuscripts/1/approve"   -H "Authorization: Bearer $ED_TOKEN" -H 'Content-Type: application/json' -d '{}')
ED_LIST=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/api/admin/manuscripts" -H "Authorization: Bearer $ED_TOKEN")
chk "$ED_OWN" "200" "EDITOR 토큰으로 자기 목록"
chk "$ED_REVIEW" "403" "EDITOR 토큰으로 승인"
chk "$ED_LIST" "403" "EDITOR 토큰으로 심사 목록"

say ""
say "── S15  공개 진위 확인 응답에 개인정보 키 부재 ───────────────────"
say "기대: 비로그인으로 나가는 유일한 개인 데이터다. 필드가 일곱뿐이어야 한다."
say "     여기서는 <b>선언</b>만 본다 — 살아 있는 인증서로 하는 실측은 컬렉션 W05 가 한다"
say "     (필드 집합 동일성 + 이메일·전화 정규식). 정리 직후에는 인증서가 없어 여기서 실측할 수 없다."
VERIFY_FIELDS=$(grep -A 3 'public record CertificateVerifyResponse' \
  src/main/java/com/templestamp/certificate/dto/CertificateVerifyResponse.java | tr -d '\n')
say "  선언: $(echo "$VERIFY_FIELDS" | sed 's/.*CertificateVerifyResponse(//' | cut -c1-160)"
LEAKY=0
for KEY in userId email phone address nickname holderNickname userSentence photoKey; do
  echo "$VERIFY_FIELDS" | grep -qw "$KEY" && { ng "verify 응답 선언에 $KEY 가 있다"; LEAKY=1; }
done
[ "$LEAKY" = "0" ] && ok "verify 응답 선언에 개인정보 키 없음"
# 살아 있는 번호가 있으면 실제 응답도 본다(정리 뒤에는 없을 수 있다).
LIVE_SERIAL=$(q "SELECT serial_no FROM certificate ORDER BY certificate_id DESC LIMIT 1;")
if [ -n "$LIVE_SERIAL" ]; then
  BODY=$(curl -s "$BASE/api/certificates/verify/$LIVE_SERIAL")
  if echo "$BODY" | grep -qE '"(userId|email|phone|address)"'; then ng "실제 verify 응답에 개인정보 키가 있다"
  else ok "실제 verify 응답($LIVE_SERIAL)에도 없음"; fi
else
  say "  ➖ 살아 있는 인증서가 없어 실제 응답은 보지 못했다(정리 직후). 선언 검사만 했다."
fi

say ""
say "── S16  배송 정보는 관리자 심사 응답에만 ────────────────────────"
say "기대: 사용자 보상 목록 질의에는 주소가 없고, 관리자 심사 질의에만 있다."
USER_SELECT=$(sed -n '/<sql id="rowSelect">/,/<\/sql>/p' src/main/resources/mapper/reward/UserRewardMapper.xml)
if echo "$USER_SELECT" | grep -qE 'address|recipient_name|phone'; then
  ng "사용자 보상 목록 질의가 배송 정보를 조인한다"
else ok "사용자 보상 목록 질의에 배송 정보 없음"; fi
ADMIN_SELECT=$(sed -n '/<select id="findUnderReview"/,/<\/select>/p' src/main/resources/mapper/reward/UserRewardMapper.xml)
if echo "$ADMIN_SELECT" | grep -q 'rc.address'; then ok "관리자 심사 질의에는 배송 정보가 있다"
else ng "관리자 심사 질의에 배송 정보가 없다"; fi
if grep -qE 'private String (address|phone|recipientName)' src/main/java/com/templestamp/reward/dto/RewardRow.java; then
  ng "사용자용 RewardRow 에 배송 정보 필드가 있다"
else ok "사용자용 DTO 에 배송 정보 필드 없음"; fi

say ""
say "── S17  좌표 반입 차단 — 음성 테스트 ────────────────────────────"
say "기대: 관리자 사찰 경로 밖에서는 어디에도 위·경도가 실려 들어가지 못한다."
for PATHX in "/api/thinkbox" "/api/meditations/logs" "/api/pilgrimages"; do
  CODE=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE$PATHX" -H 'Content-Type: application/json' \
    -H "Authorization: Bearer $SEC_TOKEN" -d '{"latitude":37.5,"longitude":127.0}')
  chk "$CODE" "400" "좌표를 실은 $PATHX"
done
GUARD_WHITELIST=$(grep -c 'api/admin/sites' src/main/java/com/templestamp/global/*/CoordinateFieldGuard.java 2>/dev/null || \
                  grep -rc 'api/admin/sites' $(grep -rl 'class CoordinateFieldGuard' src/main/java) 2>/dev/null)
say "  화이트리스트에 /api/admin/sites 가 적힌 줄: ${GUARD_WHITELIST:-0}"

say ""
say "── S18  refresh 재사용 탐지 → 전 세션 무효 ──────────────────────"
say "기대: 이미 쓴 리프레시 토큰이 다시 오면 그 사용자의 살아 있는 토큰을 전부 폐기한다."
COOKIE=$(mktemp)
curl -s -o /dev/null -c "$COOKIE" -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json' \
  --data-binary @backend/docs/verify/body/sec-login.json
cp "$COOKIE" "$COOKIE.old"          # 이 쿠키가 곧 "이미 쓴 토큰" 이 된다
curl -s -o /dev/null -b "$COOKIE" -c "$COOKIE" -X POST "$BASE/api/auth/refresh"
REUSE=$(curl -s -o /dev/null -w '%{http_code}' -b "$COOKIE.old" -X POST "$BASE/api/auth/refresh")
chk "$REUSE" "401" "폐기된 토큰 재사용"
ALIVE=$(q "SELECT COUNT(*) FROM refresh_token rt JOIN users u ON u.user_id = rt.user_id
            WHERE u.email = 'sec-check@test.com' AND rt.revoked_at IS NULL AND rt.expires_at > NOW();")
chk "${ALIVE:-?}" "0" "재사용 탐지 뒤 살아 있는 리프레시 토큰"
rm -f "$COOKIE" "$COOKIE.old"

say ""
say "── S19  탈퇴 뒤에는 옛 토큰이 전부 죽는다 ───────────────────────"
say "기대: 액세스 토큰이 아직 안 만료됐어도 401. 상태 없는 JWT 라 서버가 매 요청 users.status 를 본다."
S19_MAIL="s19-$(date +%s)@test.com"
S19_SIGNUP=$(mktemp); S19_LOGIN=$(mktemp); S19_PW=$(mktemp)
node -e "const fs=require('fs');const m=process.argv[1];
  fs.writeFileSync(process.argv[2], JSON.stringify({email:m,password:'Test1234!',nickname:'탈퇴점검'}),'utf8');
  fs.writeFileSync(process.argv[3], JSON.stringify({email:m,password:'Test1234!'}),'utf8');
  fs.writeFileSync(process.argv[4], JSON.stringify({password:'Test1234!'}),'utf8');" \
  "$S19_MAIL" "$S19_SIGNUP" "$S19_LOGIN" "$S19_PW"
curl -s -o /dev/null -X POST "$BASE/api/auth/signup" -H 'Content-Type: application/json' --data-binary @"$S19_SIGNUP"
S19_JAR=$(mktemp)
S19_TOKEN=$(curl -s -c "$S19_JAR" -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json' \
  --data-binary @"$S19_LOGIN" \
  | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).data.accessToken)}catch(e){console.log('')}})")
S19_BEFORE=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/api/users/me" -H "Authorization: Bearer $S19_TOKEN")
chk "$S19_BEFORE" "200" "탈퇴 전 내 정보"
S19_DEL=$(curl -s -o /dev/null -w '%{http_code}' -X DELETE "$BASE/api/users/me" \
  -H "Authorization: Bearer $S19_TOKEN" -H 'Content-Type: application/json' --data-binary @"$S19_PW")
chk "$S19_DEL" "204" "탈퇴"
S19_AFTER=$(curl -s -o /dev/null -w '%{http_code}' "$BASE/api/users/me" -H "Authorization: Bearer $S19_TOKEN")
chk "$S19_AFTER" "401" "탈퇴 뒤 같은 액세스 토큰"
S19_REF=$(curl -s -o /dev/null -w '%{http_code}' -b "$S19_JAR" -X POST "$BASE/api/auth/refresh")
chk "$S19_REF" "401" "탈퇴 뒤 리프레시 쿠키"
rm -f "$S19_JAR" "$S19_SIGNUP" "$S19_LOGIN" "$S19_PW"

say ""
say "── S20  비공개 원고는 사용자 응답에 새로 나가지 않는다 ───────────"
say "기대: DRAFT·SUBMITTED·REJECTED·RETIRED 본문이 사용자 API 로 새로 나가지 않는다."
say "     (이미 참조된 도장의 응답에는 그대로 남는다 — 그건 그 시점의 글이다.)"
S20_LEAK=$(q "SELECT COUNT(*) FROM manuscript m
               JOIN stamp s ON s.manuscript_id = m.manuscript_id OR s.ext_manuscript_id = m.manuscript_id
               WHERE m.status IN ('DRAFT','SUBMITTED','REJECTED')
                 AND s.verify_status <> 'COMPLETED';")
chk "${S20_LEAK:-?}" "0" "심사 전 원고를 붙든 진행 중 도장"
S20_PICKABLE=$(q "SELECT COUNT(*) FROM manuscript WHERE status <> 'APPROVED' AND site_id IS NULL;")
chk "${S20_PICKABLE:-?}" "0" "기본 원고 중 승인 아닌 것"
S20_SELECT=$(grep -c "status = 'APPROVED'" backend/../src/main/resources/mapper/manuscript/ManuscriptMapper.xml 2>/dev/null \
  || grep -c "APPROVED" src/main/resources/mapper/manuscript/ManuscriptMapper.xml)
if [ "${S20_SELECT:-0}" -gt 0 ]; then ok "선택 질의가 APPROVED 만 고른다 (findApproved)"; else ng "선택 질의에 APPROVED 조건이 없다"; fi

say ""
say "── S21  원고 금칙 4종 ───────────────────────────────────────────"
say "기대: 링크·전화·이메일·태그가 섞이면 400 MS-4002. 지우지 않고 거부한다."
S21_ED=$(curl -s -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json' \
  --data-binary @backend/docs/verify/body/editor-login.json \
  | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).data.accessToken)}catch(e){console.log('')}})")
s21() {  # $1=라벨  $2=본문
  local f code
  f=$(mktemp)
  node -e "const fs=require('fs');fs.writeFileSync(process.argv[1], JSON.stringify({siteId:null,verseNo:1,kind:'MISSION',title:'S21 금칙 점검',body:process.argv[2]}),'utf8')" "$f" "$2"
  code=$(curl -s -X POST "$BASE/api/editor/manuscripts" -H "Authorization: Bearer $S21_ED" \
    -H 'Content-Type: application/json' --data-binary @"$f" \
    | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).error.code)}catch(e){console.log('본문없음')}})")
  rm -f "$f"
  chk "$code" "MS-4002" "$1"
}
s21 "링크" "자세한 것은 https://example.com 을 보세요. 그림도 함께 실려 있습니다."
s21 "전화" "문의는 010-1234-5678 로 연락 주세요. 낮에는 받지 못합니다."
s21 "메일" "궁금하면 monk@example.com 으로 보내 주세요. 답이 늦을 수 있습니다."
s21 "태그" "여기에 <b>굵은 글씨</b>를 넣어 보았습니다. 화면에서는 그대로 보입니다."

say ""
say "── S22  관리자 사용자 목록에서 DELETED 제외 ─────────────────────"
say "기대: 탈퇴 계정이 관리자 목록에 기본으로 뜨지 않는다."
S22_PATH=$(grep -c "api/admin/users" backend/docs/audit/endpoints.md)
if [ "${S22_PATH:-0}" -gt 0 ]; then
  # 챕터 9 에서 문이 생겼다. 이제 "대상이 없다" 가 아니라 실제 응답을 본다.
  S22_ADM=$(curl -s -X POST "$BASE/api/auth/login" -H 'Content-Type: application/json' \
    --data-binary @backend/docs/verify/body/admin-login.json \
    | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{try{console.log(JSON.parse(d).data.accessToken)}catch(e){console.log('')}})")
  S22_DEFAULT=$(curl -s "$BASE/api/admin/users?size=100" -H "Authorization: Bearer $S22_ADM" \
    | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const i=JSON.parse(d).data.items;console.log(i.filter(u=>u.status!=='ACTIVE').length)})")
  chk "${S22_DEFAULT:-?}" "0" "기본 목록에 ACTIVE 아닌 계정"
  S22_LEAK=$(curl -s "$BASE/api/admin/users?size=100" -H "Authorization: Bearer $S22_ADM" \
    | grep -cE '"(password|passwordHash|token|address|phone)"' || true)
  chk "${S22_LEAK:-?}" "0" "목록 응답에 해시·토큰·주소 키"
  S22_DELETED_OK=$(curl -s "$BASE/api/admin/users?status=DELETED&size=100" -H "Authorization: Bearer $S22_ADM" \
    | node -e "let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const i=JSON.parse(d).data.items;console.log(i.every(u=>u.status==='DELETED')?'yes':'no')})")
  chk "${S22_DELETED_OK:-?}" "yes" "?status=DELETED 를 명시하면 그것만 나온다"
else
  say "  ➖ 관리자 사용자 목록 API 가 <b>없다</b> — 검사할 대상이 없어 통과로 셀 수 없다."
  say "     탈퇴 계정을 목록에서 빼는 규칙은 정리.md §7-6 에 절차로만 적혀 있다."
  say "     지금 확인할 수 있는 것은 '탈퇴 계정이 DELETED 로 남아 있다' 까지다."
  S22_DELETED=$(q "SELECT COUNT(*) FROM users WHERE status = 'DELETED';")
  say "     DELETED 계정 수: ${S22_DELETED:-?}"
  SKIP22=1
fi

say ""
say "=================================================================="
say " 통과 $PASS · 실패 $FAIL   결과 파일: $OUT"
say "=================================================================="
[ "$FAIL" -eq 0 ]
