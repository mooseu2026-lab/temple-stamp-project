# ============================================================================
#  .env  —  커밋되는 파일. 비밀이 아닌 기본값만 둔다.
#
#  ★ 여기에 비밀번호·서명키를 절대 넣지 마세요. 이 파일은 git 에 올라갑니다.
#    비밀값은 전부 .env.local (gitignore 됨) 에 둡니다.
#
#  로딩 순서 (application.yml 의 spring.config.import):
#      .env  →  .env.local        나중 것이 이깁니다.
#      즉 같은 키를 둘 다 두면 .env.local 값이 씁니다.
#
#  형식: KEY=VALUE. export 접두어·따옴표 없이 씁니다.
# ============================================================================

# --- 데이터베이스 접속 대상 (비밀 아님) ---
DB_URL=jdbc:mysql://localhost:3306/temple_stamp_project?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root

# --- 프런트 오리진 (CORS 허용 목록) ---
# 휴대폰에서 붙을 때는 PC 사설 IP 로 바꿉니다. 예) http://192.168.0.23:5173
FRONTEND_URL=http://localhost:5173

# --- 서버 바인딩 ---
# 0.0.0.0 이면 같은 와이파이의 휴대폰에서 접속할 수 있습니다.
# 내 PC 에서만 쓰려면 127.0.0.1 로 바꿉니다.
SERVER_ADDRESS=0.0.0.0

# --- 스키마·시드 실행 여부 ---
# always: 기동마다 schema.sql + data.sql 반영 (둘 다 멱등이라 안전)
# never : 아무것도 실행하지 않음
SQL_INIT_MODE=always
HOEHYANG_MIN_COURSES=12
