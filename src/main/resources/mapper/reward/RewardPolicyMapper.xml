<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.templestamp.reward.RewardPolicyMapper">

    <sql id="columns">
        reward_policy_id, code, reward_type, trigger_type, name, description,
        is_active, created_at, updated_at
    </sql>

    <select id="findById" resultType="com.templestamp.reward.RewardPolicy">
        SELECT <include refid="columns"/> FROM reward_policy WHERE reward_policy_id = #{rewardPolicyId}
    </select>

    <select id="findByTrigger" resultType="com.templestamp.reward.RewardPolicy">
        SELECT <include refid="columns"/>
        FROM reward_policy
        WHERE trigger_type = #{triggerType} AND is_active = 1
        ORDER BY reward_policy_id
    </select>

    <select id="findAllActive" resultType="com.templestamp.reward.RewardPolicy">
        SELECT <include refid="columns"/>
        FROM reward_policy
        WHERE is_active = 1
        ORDER BY trigger_type, reward_policy_id
    </select>

</mapper>
