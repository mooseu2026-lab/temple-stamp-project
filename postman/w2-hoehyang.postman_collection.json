  {
   "name": "W27 재성립하면 회수됐던 보상이 같은 행으로 돌아온다",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const it = pm.response.json().data.items;",
       "console.log('[W27] ' + it.map(r => r.userRewardId + ':' + r.status).join(', '));",
       "const target = Number(pm.environment.get(\"wRevokedReward\"));",
       "const same = it.filter(r => r.userRewardId === target);",
       "// 재적립이면 새 id 로 한 줄이 더 생긴다. 복귀면 그 id 그대로 한 줄이다.",
       "pm.test('회수됐던 보상이 같은 id 로 한 줄만 있다', () => pm.expect(same).to.have.lengthOf(1));",
       "pm.test('그 보상이 GRANTED 로 돌아왔다', () => pm.expect(same[0].status).to.eql('GRANTED'));",
       "// 재성립으로 회향 보상이 새로 붙는 것은 정상이다 — 그래서 전체 행 수는 늘 수 있다.",
       "// 여기서 안 되는 것은 '회수된 채 남는 것' 이다.",
       "pm.test('회수 상태로 남은 보상이 없다', () => pm.expect(it.filter(r => r.status === 'REVOKED')).to.have.lengthOf(0));"
      ]
     }
    }
   ],
