  {
   "name": "W21b 회향 실물 보상이 적립되고 claimable 이 켜진다",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const it = pm.response.json().data.items;",
