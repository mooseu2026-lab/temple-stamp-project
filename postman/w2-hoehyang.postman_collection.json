   "name": "W19b 인증서는 새 번호로 재발행된다 (옛 번호는 무효로 남는다)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const it = pm.response.json().data.items;",
       "console.log('[W19b] ' + it.map(x => x.certType + ':' + x.serialNo + ':' + x.status).join(', '));",
       "const pg = it.filter(x => x.certType === 'PILGRIMAGE');",
       "const valid = pg.filter(x => x.status === 'VALID');",
       "pm.test('유효한 코스 인증서 1장', () => pm.expect(valid).to.have.lengthOf(1));",
       "pm.test('번호가 옛 번호와 다르다', () => pm.expect(valid[0].serialNo).to.not.eql(pm.environment.get('wCertOld')));",
       "pm.test('옛 번호는 REVOKED 로 남아 있다', () => pm.expect(pg.some(x => x.serialNo === pm.environment.get('wCertOld') && x.status === 'REVOKED')).to.be.true);",
       "pm.environment.set('wCertId', valid[0].certificateId);",
       "pm.environment.set('wCertNew', valid[0].serialNo);"
      ]
     }
    }
