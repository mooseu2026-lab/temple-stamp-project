  {
   "name": "W17c 아직 아무도 움직이지 않은 보상만 회수된다",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const it = pm.response.json().data.items;",
       "console.log('[W17c] ' + it.map(r => r.rewardType + ':' + r.status).join(', '));",
       "pm.test('코스 완주 보상이 회수됐다', () => pm.expect(it.some(r => r.status === 'REVOKED')).to.be.true);",
       "pm.test('회수된 것은 claimable 이 아니다', () => pm.expect(it.filter(r => r.status === 'REVOKED').every(r => r.claimable === false)).to.be.true);",
       "pm.environment.set('wRewardCount', it.length);",
       "const revoked = it.find(r => r.status === 'REVOKED');",
       "pm.environment.set('wRevokedReward', revoked ? revoked.userRewardId : 0);"
      ]
     }
    }
   ],
