  {
   "name": "W17b 인증서는 지워지지 않고 REVOKED 로 남는다",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200', () => pm.response.to.have.status(200));",
       "const it = pm.response.json().data.items;",
       "const old = it.find(x => x.serialNo === pm.environment.get('wCertOld'));",
       "console.log('[W17b] ' + it.map(x => x.certType + ':' + x.serialNo + ':' + x.status).join(', '));",
       "pm.test('옛 번호가 목록에 남아 있다', () => pm.expect(old).to.not.be.undefined);",
       "pm.test('REVOKED', () => pm.expect(old.status).to.eql('REVOKED'));",
       "pm.test('회수 시각이 있다', () => pm.expect(old.revokedAt).to.not.be.null);"
      ]
     }
    }
   ],
